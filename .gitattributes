# Keep the distributed package lean: exclude development-only paths from
# the `composer require` dist tarball (git archive / Packagist).
/.github            export-ignore
/docs               export-ignore
/tests              export-ignore
/workbench          export-ignore
/.ai                export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.editorconfig      export-ignore
/phpunit.xml        export-ignore
/phpstan.neon.dist  export-ignore
/testbench.yaml     export-ignore
/CHANGELOG.md       export-ignore
/artisan            export-ignore
/astro.config.mjs   export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/public             export-ignore
/boost.json         export-ignore
/.mcp.json          export-ignore
/.codex             export-ignore
/.claude            export-ignore
/.agents            export-ignore
/AGENTS.md          export-ignore
/CLAUDE.md          export-ignore

# Normalize line endings.
*.php text eol=lf
