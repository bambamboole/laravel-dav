        "search.is-not-defined": {
            "details": "works for category but not all properties",
            "support": "fragile"
        },
        "search.is-not-defined.class": {
            "support": "unsupported"
        },
        "search.is-not-defined.dtend": {
            "support": "unsupported"
        },
        "search.text.case-sensitive": {
            "support": "unsupported"
        },
        "search.time-range.alarm": {
            "support": "unsupported"
        },
        "search.time-range.open.start.duration": {
            "behaviour": "asymmetric DURATION support: VTODO unsupported, VEVENT supported",
            "support": "broken"
        }
    },
    "errored_checks": [
        "CheckRecurrenceSearch"
    ]
