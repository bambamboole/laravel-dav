{
    "features": {
        "principal-search": {
            "support": "ungraceful"
        },
        "principal-search.by-name": {
            "support": "unsupported"
        },
        "principal-search.list-all": {
            "support": "ungraceful"
        },
        "save-load.event.timezone": {
            "behaviour": "Event with timezone was saved but could not be loaded",
            "support": "broken"
        },
        "scheduling": {
            "support": "unsupported"
