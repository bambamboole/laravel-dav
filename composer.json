{
    "name": "bambamboole/laravel-dav",
    "description": "CalDAV and CardDAV server for Laravel, powered by sabre/dav, with a typed DTO API.",
    "keywords": ["laravel", "caldav", "carddav", "webdav", "dav", "sabre", "calendar", "contacts", "ical", "vcard"],
    "homepage": "https://github.com/bambamboole/laravel-dav",
    "license": "MIT",
    "authors": [
        {
            "name": "Manuel Christlieb",
            "email": "manuel@christlieb.eu",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/bambamboole/laravel-dav/issues",
        "source": "https://github.com/bambamboole/laravel-dav"
    },
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "sabre/dav": "^4.7"
    },
    "require-dev": {
        "ext-sockets": "*",
        "amphp/amp": "^3.1",
        "amphp/http-server": "^3.4",
        "illuminate/process": "^12.0 || ^13.0",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.7"
    },
    "autoload": {
        "psr-4": { "Bambamboole\\LaravelDav\\": "src/", "Bambamboole\\LaravelDav\\Database\\Factories\\": "database/factories/" }
    },
    "autoload-dev": {
        "psr-4": {
            "Bambamboole\\LaravelDav\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": { "providers": ["Bambamboole\\LaravelDav\\LaravelDavServiceProvider"] }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "lint:check": "pint --test",
        "phpstan": "phpstan analyse --no-progress",
        "all": [
            "@lint",
            "@phpstan",
            "@test"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": { "sort-packages": true, "allow-plugins": { "pestphp/pest-plugin": true } },
    "minimum-stability": "stable",
    "prefer-stable": true
}
